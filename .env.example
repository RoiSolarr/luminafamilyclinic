# ---------------------------------------------------------------------------
# Lumina Family Clinic - environment variables
# Copy this file to `.env.local` for local development and paste the same
# values into Vercel > Project > Settings > Environment Variables for production.
#
# Only NEXT_PUBLIC_* values reach the browser. Everything else stays on the
# server: the browser never sees the database URL, a webhook URL or a secret.
# ---------------------------------------------------------------------------

# Both strings come from the same place: open your project on supabase.com and
# click the "Connect" button in the top bar. A dialog opens with every
# connection option in it. Replace [YOUR-PASSWORD] in each string with your real
# database password, and percent encode any symbols in it (@ becomes %40).
#
# ---------------------------------------------------------------------------
# DATABASE_URL: used by the running website.
# In the Connect dialog pick "Transaction pooler", port 6543.
# This is the right one for Vercel: serverless functions open and close
# connections constantly, and the pooler is built for exactly that.
# db/index.ts already sets prepare: false, which transaction mode requires.
#
# postgresql://postgres.abcdefghijklm:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# ---------------------------------------------------------------------------
# DIRECT_DATABASE_URL: used only by db:migrate, db:seed and db:reset, which run
# from your own machine, not from Vercel.
# In the Connect dialog pick "Session pooler", port 5432.
#
# Why a second string at all: migrations create enum types, partial indexes and
# triggers in one session, and they take a lock while they run. Transaction mode
# does not keep session state between statements and does not support prepared
# statements, so a migration can fail there in confusing ways. Session mode
# behaves like a normal Postgres connection and is safe for this.
#
# Why "Session pooler" and not the option labelled "Direct connection": the
# direct one resolves over IPv6 only unless you buy Supabase's IPv4 add on. Most
# home ISPs do not hand out IPv6, so it usually fails with ENOTFOUND. The
# session pooler is IPv4 on every plan and does the same job here.
#
# Leave this empty and the scripts fall back to DATABASE_URL. That often works,
# but if a migration fails oddly, this is the first thing to fix.
#
# postgresql://postgres.abcdefghijklm:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DIRECT_DATABASE_URL=

# Zapier "Catch Hook" URLs, one per Zap. Create the Zap, copy the hook URL
# shown in the trigger step, paste it here. See docs/ZAPIER_SETUP.md.
ZAPIER_BOOKING_WEBHOOK_URL=
ZAPIER_CANCEL_WEBHOOK_URL=
ZAPIER_RESCHEDULE_WEBHOOK_URL=
ZAPIER_CONTACT_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Brevo, for patient facing email (confirmations, cancellations, reschedules).
# These are sent by the app itself, not by Zapier. Staff alerts stay in Zapier.
#
# 1. Sign up at brevo.com
# 2. Senders, Domains & Dedicated IPs > Domains > add your domain, then add the
#    DKIM and DMARC records it gives you to your DNS. Without this, mail from
#    your domain lands in spam.
# 3. SMTP & API > API Keys > Generate a new API key
#
# While testing you can skip the domain step and use a single verified sender
# address instead, under Senders. Mail will send, but deliverability is poor,
# so do not demo to a client that way.
BREVO_API_KEY=

# Must be a sender Brevo has verified, or on a domain you authenticated above.
# Leave BREVO_API_KEY or this empty and the app simply skips sending, which is
# fine while you are still building.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Lumina Family Clinic

# Where patient replies go. Optional. A real clinic should use a monitored
# inbox, because patients will reply to a confirmation whatever you tell them.
EMAIL_REPLY_TO=

# Shared secret Zapier must send back in the `x-zapier-secret` header when it
# calls /api/zapier/callback or /api/zapier/due-reminders.
# Generate one: openssl rand -hex 32
ZAPIER_CALLBACK_SECRET=

# Password for the read only staff dashboard at /admin (HTTP Basic auth,
# username `staff`). Use a long random string.
ADMIN_PASSWORD=

# Secret used to sign post visit feedback links. Generate a second random value.
FEEDBACK_LINK_SECRET=

# Public base URL of the deployment. Used to build manage links and metadata.
# Local: http://localhost:3000   Production: https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mock mode. `true` runs the whole site on in memory seed data so you can click
# through every screen before Supabase and Zapier exist. Set to `false` once
# DATABASE_URL works.
NEXT_PUBLIC_MOCK_MODE=true
